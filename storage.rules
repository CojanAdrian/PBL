rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Report photos uploaded by ReportService.swift as reports/{reportId}.jpg.
    // Any signed-in user can view them. Uploads must be images under 5 MB,
    // and an existing photo can never be overwritten or deleted by a client.
    match /reports/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
